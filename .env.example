# SERVER-ONLY settings for real admin login. Set these in Netlify (Site settings > Environment variables)
# or in a local, git-ignored .env used by `netlify dev`. Never prefix them with VITE_ and never commit real values.
ADMIN_SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Generate each passwordHash with:  node scripts/hash-admin-password.mjs
ADMIN_ACCOUNTS=[{"name":"Your Name","email":"you@example.com","role":"super_admin","passwordHash":"scrypt$16384$...$..."}]
# Optional (public flag, not a secret): set to false in production to disable the built-in demo accounts.
# VITE_DEMO_ADMIN=false
